<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LearnBackend.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project use internal types of the API -->
    <InternalsVisibleTo Include="LearnBackend.Tests" />
  </ItemGroup>

  <!-- The test harness is NOT part of the API: it is compiled at runtime, together with
       the learner's code, by Roslyn. So we exclude it from compilation and embed it as a resource. -->
  <ItemGroup>
    <Compile Remove="CodeRunner\Harness\**" />
    <EmbeddedResource Include="CodeRunner\Harness\*.cs" LogicalName="Harness.%(Filename).cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LearnBackend.Sandbox\LearnBackend.Sandbox.csproj" />
  </ItemGroup>

</Project>
