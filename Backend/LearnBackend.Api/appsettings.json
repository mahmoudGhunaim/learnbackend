{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=learn.db"
  },
  "Content": {
    "RootPath": "../../content",
    "RepoRoot": "../.."
  },
  "Sandbox": {
    "TimeoutSeconds": 5,
    "MemoryLimitMb": 256,
    "MaxOutputChars": 20000,
    "MaxConcurrentRuns": 4
  },
  "Learning": {
    "UnlockAllPhases": false,
    "PassingQuizScore": 4
  }
}
